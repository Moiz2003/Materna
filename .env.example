# Band Pro API key (promo BANDHACK26)
BAND_API_KEY=your_band_api_key_here
BAND_WORKSPACE=your_workspace_id

# AI/ML API key (partner-prize eligibility)
AIML_API_KEY=your_aiml_api_key_here
AIML_BASE_URL=https://openrouter.ai/api/v1

# AI/ML API vision model (multimodal — must support image inputs)
# Options: gpt-4o, gpt-4-vision-preview, claude-3-5-sonnet, gemini-1.5-pro
AIML_VISION_MODEL=gpt-4o

# Materna internal security — shared secret between Clinify Express proxy and FastAPI
# Generate: openssl rand -hex 32
MATERNA_INTERNAL_SECRET=your_64_char_hex_secret_here_change_me

# Origins allowed to call Materna directly (Clinify Express URL)
MATERNA_ALLOWED_ORIGINS=http://localhost:5000

# Set to "1" for local dev / hackathon demo without Clinify proxy
# DO NOT enable in production — it opens the secret gate
MATERNA_DEMO_MODE=0

# Gemini API key (primary AI provider for extraction, falls back to OpenRouter)
# GEMINI_API_KEY=your_gemini_key_here
